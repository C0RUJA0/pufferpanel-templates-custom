{
  "type": "cs2",
  "display": "Counter-Strike 2 Dedicated Server",
  "data": {
    "gslt": {
      "type": "string",
      "value": "",
      "display": "GSLT Token",
      "desc": "Token em steamcommunity.com/dev/managegameservers (appid 730). Obrigatorio p/ internet publica.",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 27015,
      "display": "Game Port",
      "desc": "Porta UDP/TCP do servidor.",
      "required": true,
      "userEdit": true
    },
    "maxplayers": {
      "type": "integer",
      "value": 10,
      "display": "Max Players",
      "desc": "Numero de vagas (-maxplayers_override + sv_visiblemaxplayers).",
      "required": true,
      "userEdit": true
    },
    "sv_password": {
      "type": "string",
      "value": "",
      "display": "Senha do server",
      "desc": "Senha de entrada. Vazio = server aberto.",
      "required": false,
      "userEdit": true
    },
    "rcon_password": {
      "type": "string",
      "value": "",
      "display": "RCON Password",
      "desc": "Admin remoto via RCON. Vazio = RCON desabilitado.",
      "required": false,
      "userEdit": true
    },
    "map_mode": {
      "type": "option",
      "value": "official",
      "display": "Fonte do mapa",
      "desc": "Como o mapa inicial e escolhido.",
      "required": true,
      "userEdit": true,
      "options": [
        { "value": "official", "display": "Mapa oficial (abaixo)" },
        { "value": "workshop", "display": "Workshop: 1 mapa (ID abaixo)" },
        { "value": "collection", "display": "Workshop: colecao (ID abaixo)" }
      ]
    },
    "map": {
      "type": "option",
      "value": "de_dust2",
      "display": "Mapa oficial",
      "desc": "Usado quando 'Fonte do mapa' = oficial.",
      "required": false,
      "userEdit": true,
      "options": [
        { "value": "de_dust2", "display": "Dust II" },
        { "value": "de_mirage", "display": "Mirage" },
        { "value": "de_inferno", "display": "Inferno" },
        { "value": "de_nuke", "display": "Nuke" },
        { "value": "de_ancient", "display": "Ancient" },
        { "value": "de_anubis", "display": "Anubis" }
      ]
    },
    "workshop_map": {
      "type": "string",
      "value": "",
      "display": "Workshop Map ID",
      "desc": "ID numerico de 1 mapa. Usado quando 'Fonte do mapa' = workshop.",
      "required": false,
      "userEdit": true
    },
    "workshop_collection": {
      "type": "string",
      "value": "",
      "display": "Workshop Collection ID",
      "desc": "ID de colecao publica. Usado quando 'Fonte do mapa' = collection.",
      "required": false,
      "userEdit": true
    },
    "extra_args": {
      "type": "string",
      "value": "",
      "display": "Args extras",
      "required": false,
      "userEdit": true
    }
  },
  "install": [
    { "if": "env == 'host'", "type": "steamgamedl", "appId": "730" },
    {
      "if": "env == 'docker'",
      "type": "writefile",
      "target": "install-game.sh",
      "text": "#!/bin/sh\nset -e\nSTEAMCMD=/home/steam/steamcmd/steamcmd.sh\n[ -x \"$STEAMCMD\" ] || STEAMCMD=steamcmd\n\"$STEAMCMD\" +force_install_dir \"$(pwd)\" +login anonymous +app_update 730 validate +quit\n"
    },
    { "if": "env == 'docker'", "type": "command", "commands": [ "sh install-game.sh" ] },
    {
      "type": "writefile",
      "target": "cs2-start.sh",
      "text": "#!/bin/sh\nMAPFLAG=\"+map ${map}\"\nif [ \"${map_mode}\" = \"collection\" ] && [ -n \"${workshop_collection}\" ]; then MAPFLAG=\"+host_workshop_collection ${workshop_collection}\"; elif [ \"${map_mode}\" = \"workshop\" ] && [ -n \"${workshop_map}\" ]; then MAPFLAG=\"+host_workshop_map ${workshop_map}\"; fi\nGSLT=\"\"\n[ -n \"${gslt}\" ] && GSLT=\"+sv_setsteamaccount ${gslt}\"\nSVPW=\"\"\n[ -n \"${sv_password}\" ] && SVPW=\"+sv_password ${sv_password}\"\nRCON=\"\"\n[ -n \"${rcon_password}\" ] && RCON=\"+rcon_password ${rcon_password}\"\nexec ./game/bin/linuxsteamrt64/cs2 -dedicated -console -usercon -port ${port} -maxplayers_override ${maxplayers} $GSLT +game_type 0 +game_mode 1 +sv_visiblemaxplayers ${maxplayers} $SVPW $RCON +bot_quota 0 $MAPFLAG ${extra_args}\n"
    }
  ],
  "run": {
    "command": "sh cs2-start.sh",
    "stop": "quit",
    "stdin": { "type": "stdin" },
    "autostart": false,
    "autorecover": false,
    "autorestart": false,
    "environmentVars": { "LD_LIBRARY_PATH": "./game/bin/linuxsteamrt64" }
  },
  "environment": { "type": "host" },
  "supportedEnvironments": [
    { "type": "host" },
    {
      "type": "docker",
      "image": "cm2network/steamcmd:root"
    }
  ],
  "requirements": { "os": "linux", "arch": "amd64" }
}
